{%- liquid
  assign heading = section.settings.heading
  assign support = section.settings.support
-%}

<section
  class="akino-vibe color-{{ section.settings.color_scheme }}"
  style="
    --akino-vibe-pad-top: {{ section.settings.padding_top }}px;
    --akino-vibe-pad-bottom: {{ section.settings.padding_bottom }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="akino-vibe__inner">
    <header class="akino-vibe__header">
      {%- if heading != blank -%}
        <h2 class="akino-vibe__heading">{{ heading | escape }}</h2>
      {%- endif -%}
      {%- if support != blank -%}
        <p class="akino-vibe__support">{{ support | escape }}</p>
      {%- endif -%}
    </header>

    {%- if section.blocks.size > 0 -%}
      <ul class="akino-vibe__grid" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign item_label = block.settings.label
            assign item_detail = block.settings.detail
            assign item_link = block.settings.link
            assign item_icon = block.settings.icon | default: 'shirt'
            assign media_mode = block.settings.media_type | default: 'auto'
            assign has_media = false
            assign media_kind = ''
            assign collection_image = nil
            assign asset_video = ''

            if item_link != blank
              assign link_parts = item_link | split: '/collections/'
              if link_parts.size > 1
                assign collection_handle = link_parts | last | split: '?' | first | split: '/' | first
                if collections[collection_handle] != blank and collections[collection_handle].featured_image != blank
                  assign collection_image = collections[collection_handle].featured_image
                endif
              endif
            endif

            case forloop.index
              when 1
                assign asset_video = 'akino-hero.mp4'
              when 2
                assign asset_video = 'akino-hero-2.mp4'
              when 4
                assign asset_video = 'akino-hero-3.mp4'
            endcase

            if media_mode == 'video' or media_mode == 'auto'
              if block.settings.video != blank
                assign has_media = true
                assign media_kind = 'shopify-video'
              elsif asset_video != blank and media_mode == 'video'
                assign has_media = true
                assign media_kind = 'asset-video'
              elsif media_mode == 'auto' and asset_video != blank and block.settings.image == blank
                assign has_media = true
                assign media_kind = 'asset-video'
              endif
            endif

            if has_media == false
              if media_mode == 'image' or media_mode == 'auto'
                if block.settings.image != blank
                  assign has_media = true
                  assign media_kind = 'image'
                elsif collection_image != blank
                  assign has_media = true
                  assign media_kind = 'collection-image'
                endif
              endif
            endif
          -%}
          <li
            class="akino-vibe__item akino-vibe__item--{{ forloop.index }}{% if has_media %} akino-vibe__item--media{% endif %}"
            {{ block.shopify_attributes }}
          >
            {%- if item_link != blank -%}
              <a
                class="akino-vibe__card{% if has_media %} akino-vibe__card--media{% endif %}"
                href="{{ item_link }}"
                {% if item_label != blank %}
                  aria-label="Shop {{ item_label | escape }}"
                {% endif %}
              >
            {%- else -%}
              <div class="akino-vibe__card{% if has_media %} akino-vibe__card--media{% endif %}">
            {%- endif -%}

            {%- if has_media -%}
              <div class="akino-vibe__media" aria-hidden="true">
                {%- case media_kind -%}
                  {%- when 'shopify-video' -%}
                    {{
                      block.settings.video
                      | video_tag:
                        autoplay: true,
                        loop: true,
                        muted: true,
                        controls: false,
                        playsinline: true,
                        class: 'akino-vibe__media-el'
                    }}
                  {%- when 'asset-video' -%}
                    <video
                      class="akino-vibe__media-el"
                      autoplay
                      muted
                      loop
                      playsinline
                      preload="metadata"
                    >
                      <source
                        src="{{ asset_video | asset_url }}"
                        type="video/mp4"
                      >
                    </video>
                  {%- when 'image' -%}
                    {{
                      block.settings.image
                      | image_url: width: 1600
                      | image_tag:
                        class: 'akino-vibe__media-el',
                        loading: 'lazy',
                        widths: '400, 600, 800, 1200, 1600',
                        sizes: '(min-width: 750px) 40vw, 90vw',
                        alt: item_label
                    }}
                  {%- when 'collection-image' -%}
                    {{
                      collection_image
                      | image_url: width: 1600
                      | image_tag:
                        class: 'akino-vibe__media-el',
                        loading: 'lazy',
                        widths: '400, 600, 800, 1200, 1600',
                        sizes: '(min-width: 750px) 40vw, 90vw',
                        alt: item_label
                    }}
                {%- endcase -%}
                <span class="akino-vibe__media-shade"></span>
              </div>
            {%- endif -%}

            <span class="akino-vibe__content">
              <span class="akino-vibe__icon" aria-hidden="true">
                {%- render 'icon-or-image',
                  icon: item_icon,
                  image_upload: blank,
                  width: 42,
                  class_name: 'akino-vibe__icon-svg'
                -%}
              </span>

              <span class="akino-vibe__copy">
                {%- if item_label != blank -%}
                  <span class="akino-vibe__label">{{ item_label | escape }}</span>
                {%- endif -%}
                {%- if item_detail != blank -%}
                  <span class="akino-vibe__detail">{{ item_detail | escape }}</span>
                {%- endif -%}
                <span class="akino-vibe__cta" aria-hidden="true">Shop</span>
              </span>
            </span>

            {%- if item_link != blank -%}
              </a>
            {%- else -%}
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

<script>
  (() => {
    const root = document.querySelector('.akino-vibe-section .akino-vibe, #shopify-section-{{ section.id }} .akino-vibe');
    const sectionRoot = document.getElementById('shopify-section-{{ section.id }}');
    const scope = sectionRoot || document;
    scope.querySelectorAll('.akino-vibe__media-el').forEach((video) => {
      if (!(video instanceof HTMLVideoElement)) return;
      video.muted = true;
      video.playsInline = true;
      video.loop = true;
      const playPromise = video.play();
      if (playPromise && typeof playPromise.catch === 'function') {
        playPromise.catch(() => {});
      }
    });
  })();
</script>

{% stylesheet %}
  .akino-vibe-section {
    margin: 0;
  }

  .akino-vibe {
    padding-block-start: var(--akino-vibe-pad-top, 56px);
    padding-block-end: var(--akino-vibe-pad-bottom, 56px);
    padding-inline: var(--page-margin, 1.5rem);
    background:
      radial-gradient(90% 70% at 100% 0%, rgb(17 17 17 / 0.03), transparent 55%),
      #f7f5f1;
    color: #111;
  }

  .akino-vibe__inner {
    width: 100%;
    max-width: var(--page-content-width, 1200px);
    margin-inline: auto;
    display: grid;
    gap: 1.35rem;
  }

  .akino-vibe__header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
  }

  .akino-vibe__heading {
    margin: 0;
    font-family: var(--font-heading--family), serif;
    font-size: clamp(1.85rem, 3vw, 2.35rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: 0.01em;
    color: #111;
  }

  .akino-vibe__support {
    margin: 0;
    font-family: var(--font-body--family), sans-serif;
    font-size: 0.9375rem;
    line-height: 1.4;
    color: rgb(17 17 17 / 0.62);
  }

  .akino-vibe__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-template-rows: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    min-height: 32rem;
  }

  .akino-vibe__item {
    min-width: 0;
    min-height: 0;
  }

  .akino-vibe__item--1 {
    grid-column: 1 / span 2;
    grid-row: 1 / span 2;
  }

  .akino-vibe__item--2 {
    grid-column: 3 / span 1;
    grid-row: 1 / span 1;
  }

  .akino-vibe__item--3 {
    grid-column: 4 / span 1;
    grid-row: 1 / span 1;
  }

  .akino-vibe__item--4 {
    grid-column: 3 / span 2;
    grid-row: 2 / span 1;
  }

  .akino-vibe__item--5 {
    grid-column: 1 / span 2;
    grid-row: 3 / span 1;
  }

  .akino-vibe__item--6 {
    grid-column: 3 / span 2;
    grid-row: 3 / span 1;
  }

  .akino-vibe__item--7 {
    grid-column: 1 / span 2;
    grid-row: 4 / span 1;
  }

  .akino-vibe__item--8 {
    grid-column: 3 / span 2;
    grid-row: 4 / span 1;
  }

  .akino-vibe__card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    width: 100%;
    height: 100%;
    padding: 1.35rem 1rem;
    overflow: hidden;
    text-decoration: none;
    color: #fff;
    background: #1a1a1a;
    border: 1px solid rgb(17 17 17 / 0.2);
    border-radius: 0.35rem;
    transition:
      border-color 200ms ease,
      background-color 200ms ease,
      box-shadow 200ms ease,
      transform 200ms ease;
  }

  .akino-vibe__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .akino-vibe__media-el {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .akino-vibe__media-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(0 0 0 / 0.12) 0%, rgb(0 0 0 / 0.4) 100%);
  }

  /* Black overlay on every vibe card */
  .akino-vibe__card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: rgb(0 0 0 / 0.22);
    pointer-events: none;
    transition: background-color 200ms ease;
  }

  .akino-vibe__card--media::before {
    background: rgb(0 0 0 / 0.28);
  }

  .akino-vibe__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    width: 100%;
  }

  .akino-vibe__card--media {
    color: #fff;
    border-color: rgb(17 17 17 / 0.2);
    background: #111;
  }

  .akino-vibe__card--media .akino-vibe__icon {
    background: rgb(255 255 255 / 0.14);
    color: #fff;
    backdrop-filter: blur(6px);
  }

  .akino-vibe__card--media .akino-vibe__detail,
  .akino-vibe__card--media .akino-vibe__cta {
    color: rgb(255 255 255 / 0.78);
  }

  .akino-vibe__card::after {
    content: '';
    position: absolute;
    inset: auto 1rem 0.85rem auto;
    z-index: 2;
    width: 1.35rem;
    height: 1.35rem;
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 0.4);
    background:
      linear-gradient(#fff, #fff) center / 0.45rem 1px no-repeat,
      linear-gradient(#fff, #fff) calc(50% + 0.12rem) calc(50% - 0.12rem) / 0.45rem 1px no-repeat;
    transform: rotate(45deg) translate3d(0, 4px, 0);
    opacity: 0;
    transition: opacity 200ms ease, transform 200ms ease, border-color 200ms ease;
  }

  .akino-vibe__icon {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.14);
    color: #fff;
    transition: background-color 200ms ease, transform 200ms ease;
  }

  .akino-vibe__icon :is(svg, .icon) {
    width: 1.85rem;
    height: 1.85rem;
  }

  .akino-vibe__copy {
    display: grid;
    gap: 0.3rem;
    justify-items: center;
    text-align: center;
  }

  .akino-vibe__label {
    font-family: var(--font-subheading--family), sans-serif;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1.3;
  }

  .akino-vibe__detail {
    max-width: 16rem;
    font-family: var(--font-body--family), sans-serif;
    font-size: 0.8125rem;
    font-weight: 400;
    letter-spacing: 0.01em;
    line-height: 1.45;
    text-transform: none;
    color: rgb(255 255 255 / 0.78);
  }

  .akino-vibe__item--2 .akino-vibe__detail,
  .akino-vibe__item--3 .akino-vibe__detail {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .akino-vibe__cta {
    font-family: var(--font-body--family), sans-serif;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: rgb(255 255 255 / 0.72);
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 200ms ease, transform 200ms ease, color 200ms ease;
  }

  .akino-vibe__item--1 .akino-vibe__card {
    align-items: flex-start;
    justify-content: flex-end;
    padding: 1.75rem;
  }

  .akino-vibe__item--1 .akino-vibe__content {
    align-items: flex-start;
  }

  .akino-vibe__item--1 .akino-vibe__copy {
    justify-items: start;
    text-align: left;
  }

  .akino-vibe__item--1 .akino-vibe__label {
    font-size: 1rem;
    letter-spacing: 0.14em;
  }

  .akino-vibe__item--1 .akino-vibe__detail {
    max-width: 18rem;
  }

  .akino-vibe__item--1 .akino-vibe__icon :is(svg, .icon) {
    width: 2.1rem;
    height: 2.1rem;
  }

  .akino-vibe__item--1:not(.akino-vibe__item--media) .akino-vibe__card {
    color: #f7f5f1;
    background:
      radial-gradient(120% 90% at 100% 0%, rgb(255 255 255 / 0.12), transparent 45%),
      linear-gradient(160deg, #1a1a1a 0%, #0d0d0d 100%);
    border-color: #111;
  }

  .akino-vibe__item--1:not(.akino-vibe__item--media) .akino-vibe__icon {
    background: rgb(255 255 255 / 0.1);
    color: #f7f5f1;
  }

  .akino-vibe__item--1:not(.akino-vibe__item--media) .akino-vibe__detail,
  .akino-vibe__item--1:not(.akino-vibe__item--media) .akino-vibe__cta {
    color: rgb(247 245 241 / 0.72);
  }

  .akino-vibe__item--4:not(.akino-vibe__item--media) .akino-vibe__card,
  .akino-vibe__item--5:not(.akino-vibe__item--media) .akino-vibe__card {
    background: #f3f1ec;
    border-color: rgb(17 17 17 / 0.12);
  }

  @media (hover: hover) and (pointer: fine) {
    .akino-vibe__card:hover {
      border-color: #fff;
      background: #111;
      box-shadow: 0 10px 28px rgb(17 17 17 / 0.16);
      transform: translateY(-2px);
    }

    .akino-vibe__card:hover::before {
      background: rgb(0 0 0 / 0.34);
    }

    .akino-vibe__card:hover .akino-vibe__icon {
      background: rgb(255 255 255 / 0.22);
      transform: scale(1.04);
    }

    .akino-vibe__card:hover .akino-vibe__cta {
      opacity: 1;
      transform: translateY(0);
    }

    .akino-vibe__card:hover::after {
      opacity: 1;
      transform: rotate(45deg) translate3d(0, 0, 0);
    }

    .akino-vibe__card--media:hover {
      background: #111;
      border-color: #111;
      box-shadow: 0 14px 32px rgb(17 17 17 / 0.18);
    }

    .akino-vibe__card--media:hover .akino-vibe__media-el {
      transform: scale(1.04);
    }

    .akino-vibe__card--media:hover .akino-vibe__icon {
      background: rgb(255 255 255 / 0.2);
    }

    .akino-vibe__media-el {
      transition: transform 420ms ease;
    }
  }

  .akino-vibe__card:focus-visible {
    outline: 2px solid #111;
    outline-offset: 3px;
  }

  @media screen and (max-width: 899px) {
    .akino-vibe__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: none;
      grid-auto-rows: minmax(9rem, auto);
      min-height: 0;
      gap: 0.7rem;
    }

    .akino-vibe__item--1 {
      grid-column: 1 / span 2;
      grid-row: 1 / span 1;
      min-height: 14rem;
    }

    .akino-vibe__item--2 {
      grid-column: 1 / span 1;
      grid-row: 2 / span 1;
    }

    .akino-vibe__item--3 {
      grid-column: 2 / span 1;
      grid-row: 2 / span 1;
    }

    .akino-vibe__item--4 {
      grid-column: 1 / span 2;
      grid-row: 3 / span 1;
    }

    .akino-vibe__item--5 {
      grid-column: 1 / span 1;
      grid-row: 4 / span 1;
    }

    .akino-vibe__item--6 {
      grid-column: 2 / span 1;
      grid-row: 4 / span 1;
    }

    .akino-vibe__item--1 .akino-vibe__card,
    .akino-vibe__item--1 .akino-vibe__content {
      align-items: center;
    }

    .akino-vibe__item--1 .akino-vibe__copy {
      justify-items: center;
      text-align: center;
    }

    .akino-vibe__cta {
      opacity: 1;
      transform: none;
    }

    .akino-vibe__card::after {
      display: none;
    }
  }

  @media screen and (max-width: 749px) {
    .akino-vibe {
      padding-inline: max(1.25rem, var(--page-margin, 1.25rem));
    }

    .akino-vibe__inner {
      gap: 1.1rem;
    }

    .akino-vibe__card {
      padding: 1.2rem 0.85rem;
    }

    .akino-vibe__content {
      gap: 0.75rem;
    }

    .akino-vibe__icon {
      width: 3rem;
      height: 3rem;
    }

    .akino-vibe__label {
      font-size: 0.75rem;
      letter-spacing: 0.1em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .akino-vibe__card,
    .akino-vibe__icon,
    .akino-vibe__cta,
    .akino-vibe__card::after,
    .akino-vibe__media-el {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Vibe grid",
  "tag": "section",
  "class": "akino-vibe-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 8,
  "blocks": [
    {
      "type": "vibe",
      "name": "Vibe box",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "For Her"
        },
        {
          "type": "textarea",
          "id": "detail",
          "label": "Detail",
          "default": "Soft oversized fits made for everyday city looks."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "silhouette", "label": "Silhouette" },
            { "value": "lipstick", "label": "Lipstick" },
            { "value": "heart", "label": "Heart" },
            { "value": "shirt", "label": "Shirt" },
            { "value": "eye", "label": "Eye" },
            { "value": "fire", "label": "Fire" },
            { "value": "paw_print", "label": "Paw print" },
            { "value": "box", "label": "Box" },
            { "value": "price_tag", "label": "Price tag" },
            { "value": "lightning_bolt", "label": "Lightning" }
          ],
          "default": "shirt"
        },
        {
          "type": "select",
          "id": "media_type",
          "label": "Media type",
          "options": [
            { "value": "auto", "label": "Auto" },
            { "value": "image", "label": "Image" },
            { "value": "video", "label": "Video" },
            { "value": "none", "label": "None" }
          ],
          "default": "auto"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "visible_if": "{{ block.settings.media_type == 'image' or block.settings.media_type == 'auto' }}"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "visible_if": "{{ block.settings.media_type == 'video' or block.settings.media_type == 'auto' }}"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop your vibe"
    },
    {
      "type": "text",
      "id": "support",
      "label": "Support text",
      "default": "Pick a lane and jump in"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "Vibe grid",
      "blocks": {
        "vibe_1": {
          "type": "vibe",
          "settings": {
            "label": "For Her",
            "detail": "Soft oversized fits made for everyday city looks.",
            "link": "shopify://collections/woman",
            "icon": "lipstick",
            "media_type": "video"
          }
        },
        "vibe_2": {
          "type": "vibe",
          "settings": {
            "label": "Couple Sets",
            "detail": "Matching drops for you and your person.",
            "link": "shopify://collections/couple",
            "icon": "heart",
            "media_type": "video"
          }
        },
        "vibe_3": {
          "type": "vibe",
          "settings": {
            "label": "For Him",
            "detail": "Clean baggy fits with statement graphics.",
            "link": "shopify://collections/men",
            "icon": "shirt",
            "media_type": "image"
          }
        },
        "vibe_4": {
          "type": "vibe",
