{%- liquid
  assign eyebrow = section.settings.eyebrow
  assign heading = section.settings.heading
  assign text = section.settings.text
  assign button_label = section.settings.button_label
  assign button_link = section.settings.button_link
-%}

<section
  class="akino-about color-{{ section.settings.color_scheme }}"
  style="
    --akino-about-pad-top: {{ section.settings.padding_top }}px;
    --akino-about-pad-bottom: {{ section.settings.padding_bottom }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="akino-about__inner">
    <div class="akino-about__copy">
      {%- if eyebrow != blank -%}
        <p class="akino-about__eyebrow">{{ eyebrow | escape }}</p>
      {%- endif -%}

      {%- if heading != blank -%}
        <h2 class="akino-about__heading">{{ heading | escape }}</h2>
      {%- endif -%}

      {%- if text != blank -%}
        <div class="akino-about__text rte">{{ text }}</div>
      {%- endif -%}

      {%- if button_label != blank and button_link != blank -%}
        <a
          class="akino-about__cta"
          href="{{ button_link }}"
        >
          {{ button_label | escape }}
        </a>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul class="akino-about__features" role="list">
        {%- for block in section.blocks -%}
          <li
            class="akino-about__feature"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.heading != blank -%}
              <h3 class="akino-about__feature-title">{{ block.settings.heading | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="akino-about__feature-text">{{ block.settings.text | escape }}</p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .akino-about-section {
    margin: 0;
  }

  .akino-about {
    position: relative;
    overflow: hidden;
    padding-block-start: var(--akino-about-pad-top, 96px);
    padding-block-end: var(--akino-about-pad-bottom, 96px);
    padding-inline: var(--page-margin, 1.5rem);
    background:
      radial-gradient(120% 80% at 0% 0%, rgb(17 17 17 / 0.035), transparent 55%),
      radial-gradient(90% 70% at 100% 100%, rgb(17 17 17 / 0.045), transparent 50%),
      linear-gradient(180deg, #f7f5f1 0%, #f1efe9 100%);
    color: #111;
  }

  .akino-about__inner {
    width: 100%;
    max-width: var(--page-content-width, 1200px);
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    column-gap: clamp(2rem, 4vw, 3.5rem);
    row-gap: 2.5rem;
    align-items: start;
  }

  .akino-about__copy {
    max-width: 32rem;
    text-align: left;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.35rem;
    padding-block: 0.25rem;
    animation: akino-about-rise 700ms ease both;
  }

  .akino-about__eyebrow {
    margin: 0;
    font-family: var(--font-subheading--family), sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(17 17 17 / 0.65);
  }

  .akino-about__heading {
    margin: 0;
    font-family: var(--font-heading--family), serif;
    font-size: clamp(2rem, 4vw, 3.1rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: 0.02em;
    color: #111;
  }

  .akino-about__text {
    margin: 0;
    max-width: 30rem;
    font-family: var(--font-body--family), sans-serif;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: rgb(17 17 17 / 0.82);
  }

  .akino-about__text p {
    margin: 0;
  }

  .akino-about__text p + p {
    margin-block-start: 0.85rem;
  }

  .akino-about__cta {
    margin-block-start: 0.65rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 11rem;
    padding: 0.85rem 1.5rem;
    border-radius: 999px;
    border: 1px solid #111;
    background: #111;
    color: #fff;
    font-family: var(--font-subheading--family), sans-serif;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 180ms ease, color 180ms ease;
  }

  .akino-about__cta:hover,
  .akino-about__cta:focus-visible {
    background: transparent;
    color: #111;
  }

  .akino-about__features {
    list-style: none;
    margin: 0;
    padding: 0.25rem 0 0;
    display: grid;
    gap: 0;
    animation: akino-about-rise 700ms ease 80ms both;
  }

  .akino-about__feature {
    border-block-start: 1px solid rgb(17 17 17 / 0.1);
    padding-block: 1.5rem;
  }

  .akino-about__feature:first-child {
    border-block-start: 0;
    padding-block-start: 0.35rem;
  }

  .akino-about__feature:last-child {
    padding-block-end: 0.35rem;
  }

  .akino-about__feature-title {
    margin: 0 0 0.55rem;
    font-family: var(--font-heading--family), serif;
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    font-weight: 500;
    line-height: 1.25;
    color: #111;
  }

  .akino-about__feature-text {
    margin: 0;
    max-width: 28rem;
    font-family: var(--font-body--family), sans-serif;
    font-size: 0.975rem;
    line-height: 1.6;
    color: rgb(17 17 17 / 0.72);
  }

  @keyframes akino-about-rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media screen and (max-width: 899px) {
    .akino-about {
      padding-block-start: max(4rem, var(--akino-about-pad-top, 96px) * 0.75);
      padding-block-end: max(4rem, var(--akino-about-pad-bottom, 96px) * 0.75);
    }

    .akino-about__inner {
      grid-template-columns: 1fr;
      gap: 2.75rem;
    }

    .akino-about__copy {
      max-width: 40rem;
    }
  }

  @media screen and (max-width: 749px) {
    .akino-about {
      padding-inline: max(1.25rem, var(--page-margin, 1.25rem));
    }

    .akino-about__copy {
      gap: 1.1rem;
    }

    .akino-about__text {
      font-size: 1rem;
    }

    .akino-about__cta {
      min-width: 10.5rem;
      width: 100%;
      max-width: 18rem;
    }

    .akino-about__feature {
      padding-block: 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .akino-about__copy,
    .akino-about__features {
      animation: none;
    }
  }
{% endstylesheet %}

