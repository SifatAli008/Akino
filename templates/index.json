                "text_ecR93x": {
                  "type": "text",
                  "name": "t:names.text",
                  "settings": {
                    "text": "<p>We do not offer returns or exchanges for change of mind, so please check the size carefully before ordering. If there is a stitching or fabric defect, please report it at the time of delivery, and we'll be happy to assist you with an exchange.</p>",
