

{%- assign block_settings = block.settings -%}
<div
  id="ProductInformation-{{ section.id }}"
  class="
    product-details
    {% if block_settings.sticky_details_desktop %} sticky-content--desktop{% endif %}
    {% if block_settings.height == 'fill' -%} full-height--desktop{% endif -%}
  "
  style="--details-position: {{ block_settings.details_position }};"
  data-testid="product-information-details"
  {% if settings.transition_to_main_product %}
    data-view-transition-type="product-details"
  {% endif %}
>
  {% capture children %}
    <div class="view-product-title">
      <a
        href="{{ closest.product.selected_or_first_available_variant.url }}"
        class="link"
      >
        {{- closest.product.title }}
      </a>
    </div>
    {% content_for 'blocks' %}
  {% endcapture %}

  {% render 'group', children: children, settings: block_settings, shopify_attributes: block.shopify_attributes %}
</div>

{% stylesheet %}
  /* Clear padding on mobile, if not full-width */
  @media screen and (max-width: 749px) {
    .product-information.section--page-width .product-details > .group-block {
      padding-inline: 0;
    }
  }

  .view-product-title {
    display: none;
  }

  /* Container styles */
  .product-details {
    display: flex;
    align-self: start;
    justify-content: flex-start;
  }

  /* Premium info column */
  .product-details > .group-block {
    width: 100%;
    max-width: 26rem;
  }

  .product-details > .group-block > .group-block-content {
    row-gap: inherit;
  }

  .product-details .divider__line {
    border-color: rgb(var(--color-foreground-rgb) / 0.1);
  }

  /* Brand eyebrow */
  .product-details > .group-block > .group-block-content > .group-block:first-child .text-block.paragraph:first-child,
  .product-details .group-block-content > .text-block.paragraph:has(+ .text-block.h3) {
    opacity: 0.55;
  }

  .product-details .text-block.h3,
  .product-details .text-block.h3 :is(h1, h2, h3, h4, h5, h6, p) {
    font-family: var(--font-heading--family), serif;
    letter-spacing: -0.01em;
    font-weight: 600;
    line-height: 1.2;
    max-width: 24ch;
  }

  .product-details product-price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.7rem;
    color: #111;
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .product-details product-price .price,
  .product-details product-price .price-item--sale,
  .product-details product-price .price-item {
    color: #111;
    opacity: 1;
    font-weight: 600;
    font-size: 1.5rem;
  }

  .product-details product-price .compare-at-price {
    color: #555;
    opacity: 1;
    font-size: 1.1rem;
    font-weight: 500;
    text-decoration-thickness: 1.5px;
  }

  /* Size buttons + hover */
  .product-details .variant-option--buttons {
    gap: 0.6rem;
  }

  .product-details .variant-option + .variant-option {
    margin-block-start: var(--gap-md, 1rem);
  }

  .product-details .variant-option--buttons legend {
    margin-block-end: 0.75rem;
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .product-details .variant-option__button-label:not(.variant-option__button-label--has-swatch) {
    min-width: 3.25rem;
    min-height: 3rem;
    padding-inline: 1rem;
    padding-block: 0.65rem;
    transition:
      background-color 200ms ease,
      border-color 200ms ease,
      color 200ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .product-details .variant-option__button-label:not(.variant-option__button-label--has-swatch):hover {
      background-color: rgb(var(--color-foreground-rgb) / 0.08);
      border-color: rgb(var(--color-foreground-rgb) / 0.9);
      color: rgb(var(--color-foreground-rgb) / 1);
    }

    .product-details .variant-option__button-label:not(.variant-option__button-label--has-swatch):has(:checked):hover {
      background-color: #2a2a2a;
      border-color: #2a2a2a;
      color: #fff;
    }
  }

  /* Qty + Add to cart row, Buy it now full width */
  .product-details .buy-buttons-block {
    --buy-button-preferred-width: 100%;
    --pdp-btn-height: 3.25rem;
    margin-block: 0.35rem 0.15rem;
  }

  .product-details .product-form-buttons {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.85rem;
    align-items: stretch;
  }

  .product-details .product-form-buttons > *:not(.quantity-selector-wrapper) {
    flex: unset;
    min-width: 0;
  }

  .product-details .product-form-buttons .quantity-selector-wrapper {
    grid-column: 1;
  }

  .product-details .product-form-buttons .quantity-selector {
    height: var(--pdp-btn-height);
    min-width: 8rem;
    padding-inline: 0.25rem;
    transition: border-color 200ms ease, background-color 200ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .product-details .product-form-buttons .quantity-selector:hover {
      background-color: rgb(var(--color-foreground-rgb) / 0.03);
      border-color: rgb(var(--color-foreground-rgb) / 0.35);
    }

    .product-details .quantity-selector button {
      transition: background-color 180ms ease, color 180ms ease;
    }

    .product-details .quantity-selector button:hover {
      background-color: rgb(var(--color-foreground-rgb) / 0.1);
      color: var(--color-foreground);
    }
  }

  .product-details .product-form-buttons .add-to-cart-button,
  .product-details .product-form-buttons > span:has(.add-to-cart-button) {
    grid-column: 2;
    width: 100%;
  }

  .product-details .product-form-buttons .add-to-cart-button {
    min-height: var(--pdp-btn-height);
    height: var(--pdp-btn-height);
    width: 100%;
    padding-block: 0.9rem;
    padding-inline: 1.35rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: 0.8125rem;
    font-weight: 600;
    transition:
      background-color 200ms ease,
      color 200ms ease,
      border-color 200ms ease,
      box-shadow 200ms ease;
  }

  .product-details .product-form-buttons shopify-accelerated-checkout,
  .product-details .product-form-buttons .shopify-payment-button,
  .product-details .product-form-buttons > *:not(.quantity-selector-wrapper, span:has(.add-to-cart-button), .add-to-cart-button) {
    grid-column: 1 / -1;
    margin-block-start: 0.15rem;
  }

  .product-details .shopify-payment-button__button,
  .product-details button.shopify-payment-button__button--unbranded {
    min-height: var(--pdp-btn-height) !important;
    padding-block: 0.9rem !important;
    padding-inline: 1.35rem !important;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: 0.8125rem !important;
    font-weight: 600;
    transition:
      background-color 200ms ease,
      color 200ms ease,
      border-color 200ms ease,
      box-shadow 200ms ease !important;
  }

  @media (hover: hover) and (pointer: fine) {
    /* Default solid black → outlined / inverted color hover */
    .product-details .product-form-buttons .add-to-cart-button:hover:not([aria-disabled='true'], :disabled) {
      --button-color: #111;
      --button-background-color: #fff;
      --button-border-color: #111;
      background-color: #fff;
      color: #111;
      box-shadow: inset 0 0 0 1.5px #111;
    }

    .product-details .product-form-buttons .add-to-cart-button:active:not([aria-disabled='true'], :disabled) {
      background-color: #f3f3f3;
      color: #111;
      box-shadow: inset 0 0 0 1.5px #111;
    }

    .product-details .shopify-payment-button__button:hover,
    .product-details button.shopify-payment-button__button--unbranded:hover {
      background: #fff !important;
      color: #111 !important;
      box-shadow: inset 0 0 0 1.5px #111 !important;
      filter: none;
    }

    .product-details .shopify-payment-button__button:active,
    .product-details button.shopify-payment-button__button--unbranded:active {
      background: #f3f3f3 !important;
      color: #111 !important;
      box-shadow: inset 0 0 0 1.5px #111 !important;
    }
  }

  .product-details .product-form-buttons .add-to-cart-button:focus-visible {
    outline: 2px solid rgb(var(--color-foreground-rgb) / 0.85);
    outline-offset: 3px;
  }

  /* Trust / purchase notes */
  .product-details > .group-block > .group-block-content > .group-block:has(.icon-block),
  .product-details .group-block:has(> .group-block-content > .group-block .icon-block) {
    opacity: 0.85;
  }

  .product-details .group-block-content:has(> .icon-block),
  .product-details .group-block-content:has(> [class*='icon']) {
    align-items: center;
  }

  /* Accordion details + hover */
  .product-details .accordion {
    margin-block-start: 0.25rem;
  }

  .product-details .accordion .details__header {
    padding-block: 0.9rem;
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    transition: color 180ms ease, opacity 180ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .product-details .accordion .details__header:hover {
      opacity: 0.7;
    }
  }

  .product-details .accordion .details-content {
    color: rgb(var(--color-foreground-rgb) / 0.78);
  }

  .product-details .accordion .details-content .text-block {
    max-width: 38ch;
  }

  .product-details .accordion .details-content .akino-size-chart,
  .product-details .accordion .details-content .akino-product-desc,
  .product-details .accordion .details-content .akino-fabric {
    max-width: none;
  }

  .product-details .accordion .details-content .akino-size-chart__table thead th {
    background: #111;
  }

  /* Tablet */
  @media screen and (max-width: 989px) and (min-width: 750px) {
    .product-details > .group-block {
      max-width: 22rem;
    }

    .product-details .product-form-buttons .quantity-selector {
      min-width: 6.5rem;
    }
  }

  /* Mobile */
  @media screen and (max-width: 749px) {
    .product-details {
      width: 100%;
      padding-block-start: 0.5rem;
    }

    .product-details > .group-block {
      max-width: none;
      padding-inline: 0;
    }

    .product-details .text-block.h3 :is(h1, h2, h3, h4, h5, h6, p) {
      max-width: none;
      font-size: clamp(1.35rem, 5.5vw, 1.75rem);
    }

    .product-details .variant-option--buttons {
      gap: 0.4rem;
    }

    .product-details .variant-option__button-label:not(.variant-option__button-label--has-swatch) {
      min-width: 2.75rem;
      min-height: 2.75rem;
      flex: 1 1 calc(25% - 0.4rem);
    }

    .product-details .product-form-buttons {
      grid-template-columns: 1fr;
      gap: 0.65rem;
    }

    .product-details .product-form-buttons .quantity-selector-wrapper,
    .product-details .product-form-buttons .add-to-cart-button,
    .product-details .product-form-buttons > span:has(.add-to-cart-button),
    .product-details .product-form-buttons shopify-accelerated-checkout,
    .product-details .product-form-buttons .shopify-payment-button,
    .product-details .product-form-buttons > * {
      grid-column: 1 / -1;
      width: 100%;
    }

    .product-details .product-form-buttons .quantity-selector {
      width: 100%;
      max-width: none;
      min-width: 0;
    }

    .product-details .accordion .details-content .text-block {
      max-width: none;
    }

    .product-details .group-block-content:has(> .icon-block),
    .product-details .group-block-content:has(> [class*='icon']) {
      align-items: flex-start;
    }
  }

  /* Small phones */
  @media screen and (max-width: 390px) {
    .product-details .variant-option__button-label:not(.variant-option__button-label--has-swatch) {
      min-width: 0;
      padding-inline: 0.5rem;
      font-size: 0.875rem;
    }
  }

  @media screen and (min-width: 750px) {
    .product-details > .group-block {
      height: min-content;
    }

    .full-height--desktop {
      height: 100%;
      max-height: calc(100vh - var(--header-group-height, 0));
      min-height: fit-content;
    }

    .full-height--desktop .group-block {
      align-self: var(--details-position, 'flex-start');
    }
  }
{% endstylesheet %}

